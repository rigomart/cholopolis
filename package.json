{
  "name": "cholopolis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "bun run build && wrangler dev",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "deploy": "bun run check && bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "preact": "^11.0.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "^0.186.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "bun@1.3.14"
}
